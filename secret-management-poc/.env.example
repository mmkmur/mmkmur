# =============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# =============================================================

# Microsoft Entra ID – App Registration (Service Principal)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-value-here

# Azure Key Vault
AZURE_KEYVAULT_NAME=poc-keyvault-12345
# Derived automatically: https://<name>.vault.azure.net

# The name of the secret we are managing
SECRET_NAME=demo-db-password

# How many days between rotations (Key Vault expiry window)
ROTATION_INTERVAL_DAYS=30

# How often the demo app re-reads the secret from Key Vault (seconds)
# Keep low (10s) for the demo so rotation is visible quickly
SECRET_REFRESH_INTERVAL_SECONDS=10

# Azure subscription / resource group (used by setup scripts only)
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=rg-secret-poc
AZURE_LOCATION=eastus

# Azure Function local settings (set by function/local.settings.json)
# These are repeated here so the demo app can also read them
FUNCTIONS_WORKER_RUNTIME=python
